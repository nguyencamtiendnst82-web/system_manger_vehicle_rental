// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model bao_tri {
  maBT        Int                @id @default(autoincrement())
  maXe        Int
  noiDung     String?            @db.Text
  ngayBatDau  DateTime?          @db.Date
  ngayKetThuc DateTime?          @db.Date
  chiPhi      Decimal?           @default(0.00) @db.Decimal(15, 2)
  trangThai   bao_tri_trangThai? @default(CHO_BAO_TRI)
  xe          xe                 @relation(fields: [maXe], references: [maXe], map: "fk_bt_xe")

  @@index([maXe], map: "fk_bt_xe")
}

model hop_dong {
  maHD              Int                 @id @default(autoincrement())
  maKH              Int
  maXe              Int
  maNV              Int
  ngayThue          DateTime            @db.DateTime(0)
  ngayTra           DateTime            @db.DateTime(0)
  ngayTraThucTe     DateTime?           @db.DateTime(0)
  tienThue          Decimal?            @default(0.00) @db.Decimal(15, 2)
  trangThai         hop_dong_trangThai? @default(CHO_XAC_NHAN)
  khach_hang        khach_hang          @relation(fields: [maKH], references: [maKH], map: "fk_hd_khachhang")
  nhan_vien         nhan_vien           @relation(fields: [maNV], references: [maNV], map: "fk_hd_nhanvien")
  xe                xe                  @relation(fields: [maXe], references: [maXe], map: "fk_hd_xe")
  thanh_toan        thanh_toan[]
  tinh_trang_tra_xe tinh_trang_tra_xe[]

  @@index([maKH], map: "fk_hd_khachhang")
  @@index([maNV], map: "fk_hd_nhanvien")
  @@index([maXe], map: "fk_hd_xe")
}

model khach_hang {
  maKH     Int        @id @default(autoincrement())
  hoTen    String     @db.VarChar(100)
  SDT      String?    @db.VarChar(15)
  email    String?    @db.VarChar(100)
  CCCD     String?    @unique(map: "CCCD") @db.VarChar(20)
  bangLai  String?    @db.VarChar(20)
  diaChi   String?    @db.VarChar(255)
  hop_dong hop_dong[]
}

model loai_xe {
  maLoaiXe  Int    @id @default(autoincrement())
  tenLoaiXe String @db.VarChar(100)
  hangXe    String @db.VarChar(100)
  xe        xe[]
}

model nhan_vien {
  maNV     Int        @id @default(autoincrement())
  hoTen    String     @db.VarChar(100)
  SDT      String?    @db.VarChar(15)
  email    String?    @db.VarChar(100)
  hop_dong hop_dong[]
}

model thanh_toan {
  maTT       Int                   @id @default(autoincrement())
  maHD       Int
  soTien     Decimal               @db.Decimal(15, 2)
  phuongThuc thanh_toan_phuongThuc
  ngayTT     DateTime              @default(now()) @db.DateTime(0)
  hop_dong   hop_dong              @relation(fields: [maHD], references: [maHD], map: "fk_tt_hopdong")

  @@index([maHD], map: "fk_tt_hopdong")
}

model tinh_trang_tra_xe {
  maTinhTrang  Int      @id @default(autoincrement())
  maHD         Int
  ngayTra      DateTime @default(now()) @db.DateTime(0)
  tinhTrangXe  String?  @db.Text
  mucNhienLieu Int?
  soKmThucTe   Int?
  ghiChu       String?  @db.Text
  hop_dong     hop_dong @relation(fields: [maHD], references: [maHD], map: "fk_tttx_hopdong")

  @@index([maHD], map: "fk_tttx_hopdong")
}

model xe {
  maXe       Int           @id @default(autoincrement())
  maLoaiXe   Int
  bienSoXe   String        @unique(map: "bienSoXe") @db.VarChar(20)
  mauXe      String?       @db.VarChar(50)
  soKmDaChay Int?          @default(0)
  trangThai  xe_trangThai? @default(SAN_SANG)
  soCho      Int
  bao_tri    bao_tri[]
  hop_dong   hop_dong[]
  loai_xe    loai_xe       @relation(fields: [maLoaiXe], references: [maLoaiXe], map: "fk_xe_loaixe")

  @@index([maLoaiXe], map: "fk_xe_loaixe")
}

enum thanh_toan_phuongThuc {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
}

enum xe_trangThai {
  SAN_SANG
  DANG_THUE
  DANG_BAO_TRI
  NGUNG_HOAT_DONG
}

enum bao_tri_trangThai {
  CHO_BAO_TRI
  DANG_BAO_TRI
  DA_HOAN_THANH
}

enum hop_dong_trangThai {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  DANG_THUE
  DA_TRA
  DA_HUY
}
